<node id="11104401" title="Re: Complex file manipulation challenge" created="2019-08-13 13:51:48" updated="2019-08-13 13:51:48" _doctext_mode="lenient"><type id="11">note</type>
<author id="200365">Tux</author>
<doctext field_name="doctext">&lt;p&gt;Untested (assuming 2500 lines as cut-of)&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;&lt;c&gt;my @csv_files = map { $_-&gt;[0] } sort { $a-&gt;[1] &lt;=&gt; $b-&gt;[1] } map { [ $_, -s ] } glob "*.csv"&lt;/c&gt;&lt;/li&gt;
&lt;li&gt;&lt;c&gt;my @csv = map { @{csv (in =&gt; $_, headers =&gt; "skip")} } @csv_files;&lt;/c&gt;&lt;/li&gt;
&lt;li&gt;&lt;c&gt;use Text::CSV_XS qw( csv );&lt;/c&gt;&lt;br /&gt;&lt;c&gt;use PerlIO::via::gzip;&lt;/c&gt;&lt;br /&gt;&lt;c&gt;my $n = "0000";&lt;/c&gt;&lt;br /&gt;&lt;c&gt;while (@csv) {&lt;/c&gt;&lt;/li&gt;
&lt;li&gt;&lt;c&gt;    open my $fh, "&gt;:via(gzip)", "new".$n++.".csv.gz";&lt;/c&gt;&lt;br /&gt;&lt;c&gt;    csv (in =&gt; [ splice @csv, 0, (@csv &gt; 2500 ? 2500 : $#csv) ], out =&gt; $fh);}&lt;/c&gt;&lt;br /&gt;&lt;c&gt;    }&lt;/c&gt;&lt;/li&gt;
&lt;/ol&gt;
