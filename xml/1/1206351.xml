<doctext field_name="doctext">&lt;code&gt;
#!/usr/bin/perl

# http://perlmonks.org/?node_id=1206349

use strict;
use warnings;

print "Enter the IP address\n";
my $tunip = &lt;STDIN&gt;;
chomp ($tunip);

print $tunip =~ s/\d+$/ ($&amp; - 1 ^ 1) + 1 /er, "\n";
&lt;/code&gt;
