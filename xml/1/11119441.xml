<node id="11119441" title="Re: On Backwards Compatibility and Bareword Filehandles" created="2020-07-17 03:24:22" updated="2020-07-17 03:24:22" _doctext_mode="strict"><type id="11">note</type>
<author id="830549">haukex</author>
<doctext field_name="doctext">&lt;blockquote&gt;&lt;i&gt;I propose generalizing this to also allow open our $foo, ... (to explicitly open a global filehandle; remember TIMTOWTDI) and open state $foo, ...&lt;/i&gt;&lt;/blockquote&gt;
&lt;c&gt;
use warnings;
use strict;
use feature 'state';

sub xyz {
	open state $foo, '&lt;', '/tmp/foo' or die $!;
	chomp( my $bar = &lt;$foo&gt; );
	close $foo;
	return $bar;
}

open our $foo, '&gt;', '/tmp/foo' or die $!;
print $foo "Hello\n";
close $foo;

use Test::More tests=&gt;1;
is xyz(), "Hello";         # =&gt; PASS
&lt;/c&gt;
&lt;blockquote&gt;&lt;i&gt;the result will be a disaster reminiscent of Fahrenheit 451.&lt;/i&gt;&lt;/blockquote&gt;
&lt;p&gt;A variation on [wp://Godwin's law]?&lt;/p&gt;
</doctext>
