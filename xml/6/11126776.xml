&lt;/p&gt;
&lt;code&gt;
my $tagl =  $resp-&gt;decoded_content;
if($tagl =~ /&lt;div class=\"soda.*?&gt;(.*?)&lt;\/div&gt;/ism)
{
  say "inside";
  my $grp = $1;
