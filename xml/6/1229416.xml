<doctext field_name="doctext">&lt;c&gt;
    array =&gt; sub {
        my @list = @input;
        @list[@input] = @input;
        Compare(\@list,\@output) or die "@list" if DO_CHECK;
    },
&lt;/c&gt;
&lt;p&gt;
When added, outputs:
&lt;/p&gt;
