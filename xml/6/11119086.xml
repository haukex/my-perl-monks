<doctext field_name="doctext">&lt;p&gt;So more or like like this:?&lt;/p&gt;
&lt;code&gt;
DDumper csv (
    in     =&gt; *DATA,
    sep    =&gt; "|",
    filter =&gt; sub {
        $_[1][0] =~ m/^\s*#/ &amp;&amp; @{$_[1]} == 1 ? 0 : 1;
        },
    );
&lt;/code&gt;
&lt;p&gt;Which would not even need a ternary if slightly rewritten&lt;/p&gt;
