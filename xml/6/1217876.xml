<node id="1217876" title="Re: Find the shortest word in the English Language with: a b c d e f" created="2018-07-04 07:20:55" updated="2018-07-04 07:20:55" _doctext_mode="strict"><type id="11">note</type>
<author id="830549">haukex</author>
<doctext field_name="doctext">&lt;p&gt;TIMTOWTDI :-)&lt;/p&gt;
&lt;c&gt;
next unless/(?=.*a)(?=.*b)(?=.*c)(?=.*d)(?=.*e)(?=.*f)/i;push@_,$_

# ==&gt;
lc=~s/(.)(?=.*\1)//gr=~y/abcdef//&lt;6||push@_,$_

# or, on Perls &lt;5.14:
($b=lc)=~s/(.)(?=.*\1)//g;$b=~y/abcdef//&lt;6||push@_,$_
&lt;/c&gt;
&lt;p&gt;&lt;small&gt;&lt;i&gt;Update:&lt;/i&gt; &lt;c&gt;s/tr/y/&lt;/c&gt;, thanks [Eily] :-)&lt;/small&gt;&lt;/p&gt;</doctext>
