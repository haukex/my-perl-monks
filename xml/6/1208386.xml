&lt;code&gt;
#!/usr/bin/env perl
use warnings;
use strict;
use Text::CSV_XS; # also install Text::CSV_XS for speed

my $csv = Text::CSV_XS-&gt;new({ binary=&gt;1, auto_diag=&gt;2, escape_char=&gt;'\\',
    eol=&gt;$/, quote_char=&gt;'"', sep_char=&gt;";", always_quote=&gt;1 });
while ( my $row = $csv-&gt;getline(*ARGV) ) {
    $row-&gt;[5] = pack '(H2)*', split /:/, $row-&gt;[5];
    $row-&gt;[5] =~ s/\A\x19\x68\x09\x24\x00+|\x00+\z//g;
    $csv-&gt;print(select, $row);
}
$csv-&gt;eof or $csv-&gt;error_diag;
