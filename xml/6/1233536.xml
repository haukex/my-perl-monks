<doctext field_name="doctext">&lt;p&gt;Try joining the child nodes&lt;/p&gt;
&lt;c&gt;
my ($node) = $dom-&gt;findnodes('/doc/text');
my $text = join '', $node-&gt;childNodes();
print "$text\n";
&lt;/c&gt;
