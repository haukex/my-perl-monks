<doctext field_name="doctext">&lt;p&gt;Just for fun and TIMTOWTDI: If you happen to want speed, use [doc://rindex] and [doc://substr].&lt;/p&gt;
&lt;c&gt;
my $str = "a,b,c,5";
my $i = rindex $str, ',';
my ($path,$value);
if ($i&lt;0) { $path=$str }
else { $path  = substr($str, 0, $i);
       $value = substr($str, $i+1) }
&lt;/c&gt;

</doctext>
