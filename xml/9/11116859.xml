<doctext field_name="doctext">&lt;p&gt;
[mod://Text::CSV] may be helpful for your problem.
&lt;/p&gt;
&lt;code&gt;
#!/usr/bin/perl

use strict;
use warnings;
use Text::CSV;

my $data = &lt;&lt;'EOF';
1
Something\,\text\text\0x2B
X
99
1,This is a problem-&gt;\\,B,2
EOF

open my $fh, '&lt;', \$data;
my $csv = Text::CSV-&gt;new({sep_char =&gt; ','});
while (my $row = $csv-&gt;getline($fh)) {
	print "&lt;$_&gt; " foreach @$row;
	print "\n";
}
__DATA__
&lt;1&gt; 
&lt;Something\&gt; &lt;\text\text\0x2B&gt; 
&lt;X&gt; 
&lt;99&gt; 
&lt;1&gt; &lt;This is a problem-&gt;\\&gt; &lt;B&gt; &lt;2&gt; 

&lt;/code&gt;
