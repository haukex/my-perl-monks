<doctext field_name="doctext">&lt;p&gt;Any suggestions as to condensing/optimizing the following code fragment:&lt;/p&gt;

&lt;code&gt;
foreach my $i ( $from .. $to ) {

    if ($i % 2 != 0) { next; }
    elsif ($i % 3 != 0) {next; }
    elsif ($i % 4 != 0) {next; }
    elsif ($i % 5 != 0) {next; }
    else { say $i;}
}
&lt;/code&gt;</doctext>
