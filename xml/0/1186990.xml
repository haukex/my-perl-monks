<doctext field_name="doctext">&lt;p&gt;Change the root and add namespace to your selects &lt;/p&gt;
&lt;c&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" version="1.0"&gt;
&lt;xsl:output method="xml" indent="yes"/&gt;
&lt;xsl:template match="/"&gt;
&lt;Data xmlns:xsd="http://www.w3.org/2001/XMLSchema"&gt;
&lt;xsl:for-each select="xsd:File/xsd:DataDescrip"&gt;
&lt;xsl:element name="Details"&gt;
  &lt;xsl:element name="ReferenceID"&gt;
    &lt;xsl:value-of select="xsd:Reference"/&gt;
  &lt;/xsl:element&gt;
&lt;/xsl:element&gt;
&lt;/xsl:for-each&gt;
&lt;/Data&gt;
&lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;
&lt;/c&gt;
&lt;p&gt;gives&lt;/p&gt;
&lt;c&gt;
&lt;?xml version="1.0"?&gt;
&lt;Data xmlns:xsd="http://www.w3.org/2001/XMLSchema"&gt;
  &lt;Details&gt;
    &lt;ReferenceID&gt;702154&lt;/ReferenceID&gt;
  &lt;/Details&gt;
&lt;/Data&gt;
&lt;/c&gt;
poj</doctext>
