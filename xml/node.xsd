<?xml version="1.0" encoding="UTF-8"?>
<xs:schema version="1.0"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    elementFormDefault="qualified">
  <xs:annotation>
    <xs:documentation>
      This is a schema for a subset of PerlMonks nodes as generated by the request
      `?displaytype=xml;xmlstyle=flat;node_id=...`, with some modifications as
      documented throughout, plus the output of the "node query" XML Generator
      (`?node_id=37150;xmlstyle=flat;nodes=...,...`) with the informational
      "Rendered by" text removed.

      See also "What XML generators are currently available on PerlMonks?"
      at https://perlmonks.org/?node_id=72241
    </xs:documentation>
  </xs:annotation>

  <!-- ##### ##### ##### ##### ##### locked ##### ##### ##### ##### ##### -->
  <xs:element name="locked">
    <xs:annotation>
      <xs:documentation>
        "This node falls below the community's minimum standard of quality."
      </xs:documentation>
    </xs:annotation>
    <xs:complexType />
  </xs:element>

  <!-- ##### ##### ##### ##### ##### info ##### ##### ##### ##### ##### -->

  <xs:element name="info">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="node" maxOccurs="unbounded">
          <xs:complexType>
            <xs:simpleContent>
              <xs:extension base="xs:string">
                <xs:attribute name="node_id" type="id_type" use="required" />
                <xs:attribute name="author_user" type="id_type" use="required" />
                <xs:attribute name="nodetype" type="xs:string" use="required">
                  <xs:annotation>
                    <xs:documentation>Note that locked nodes will still show up with
                      their original node type here!</xs:documentation>
                  </xs:annotation>
                </xs:attribute>
                <xs:attribute name="author_name" type="xs:string" use="required" />
                <xs:attribute name="createtime" type="xs:string" use="required" />
                <xs:attribute name="lastupdate" type="xs:string" use="required" />
                <xs:attribute name="parent_node" type="id_type" />
                <xs:attribute name="root_node" type="id_type" />
                <xs:attribute name="root_type" type="xs:string" />
              </xs:extension>
            </xs:simpleContent>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ##### ##### ##### ##### ##### types ##### ##### ##### ##### ##### -->

  <xs:simpleType name="id_type">
    <xs:restriction base="xs:integer">
      <xs:minExclusive value="0" />
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="str_with_id">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="id" type="id_type" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="field_str">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:annotation>
          <xs:documentation>
            The `field_name` attribute's value must match the name of the element it is on.
          </xs:documentation>
        </xs:annotation>
        <xs:attribute name="field_name" type="xs:string" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="field_id">
    <xs:simpleContent>
      <xs:extension base="id_type">
        <xs:annotation>
          <xs:documentation>
            The `field_name` attribute's value must match the name of the element it is on.
          </xs:documentation>
        </xs:annotation>
        <xs:attribute name="field_name" type="xs:string" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="thread">
    <xs:sequence>
      <xs:element name="node" type="thread" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="id" type="id_type" use="required" />
  </xs:complexType>

  <!-- ##### ##### ##### ##### ##### node ##### ##### ##### ##### ##### -->
  <xs:element name="node">
    <xs:complexType>
      <xs:all>
        <xs:element name="type" type="str_with_id" />
        <xs:element name="author" type="str_with_id" />
        <!-- doctext -->
        <xs:element name="doctext" type="field_str" minOccurs="0" />
        <!-- note -->
        <xs:element name="root_node" type="field_id" minOccurs="0" />
        <xs:element name="parent_node" type="field_id" minOccurs="0" />
        <xs:element name="reputation" type="field_str" minOccurs="0" />
        <xs:element name="thread" type="thread" minOccurs="0">
          <xs:annotation>
            <xs:documentation>
              This element is actually not part of the normal node output, instead this is
              the output of the "node thread" XML generator `?node_id=180684;xmlstyle=flat;id=...`
              that is patched into nodes by our scraper tool. The &lt;info&gt; element
              produced that generator is removed because it is not static.
            </xs:documentation>
          </xs:annotation>
        </xs:element>
        <!-- user -->
        <xs:element name="lasttime" type="field_str" minOccurs="0" />
        <xs:element name="experience" type="field_str" minOccurs="0" />
        <xs:element name="user_scratchpad" type="field_id" minOccurs="0" />
        <xs:element name="imgsrc" type="field_str" minOccurs="0" />
        <xs:element name="timeformat" type="field_str" minOccurs="0" />
        <xs:element name="numwriteups" type="field_str" minOccurs="0" />
        <xs:element name="location" type="field_str" minOccurs="0" />
        <xs:element name="timezone" type="field_str" minOccurs="0" />
        <xs:element name="codewrapoff" type="field_str" minOccurs="0" />
        <xs:element name="codewraplength" type="field_str" minOccurs="0" />
        <xs:element name="codeautowrap" type="field_str" minOccurs="0" />
        <xs:element name="codeprefix" type="field_str" minOccurs="0" />
        <xs:element name="codebig" type="field_str" minOccurs="0" />
        <!-- sourcecode -->
        <xs:element name="codedescription" type="field_str" minOccurs="0" />
        <xs:element name="codecategory" type="field_str" minOccurs="0" />
        <xs:element name="codeauthor" type="field_str" minOccurs="0" />
        <!-- root nodes (?) -->
        <xs:element name="keywords" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="keyword" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="xs:string">
                      <xs:attribute name="rating" type="xs:string" />
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <!-- users (?) -->
        <xs:element name="vars" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="var" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="xs:string">
                      <xs:attribute name="name" type="xs:string" />
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="count" type="xs:integer" />
          </xs:complexType>
        </xs:element>
      </xs:all>
      <xs:attribute name="id" type="id_type" use="required" />
      <xs:attribute name="title" type="xs:string" use="required" />
      <xs:attribute name="created" type="xs:string" use="required" />
      <xs:attribute name="updated" type="xs:string" use="required" />
      <xs:attribute name="_doctext_mode" default="strict">
        <xs:annotation>
          <xs:documentation>
            This is an addition by our scraper to indicate whether the parser should be
            a bit more strict or not; the idea being that nodes that aren't my own can
            be treated a little more leniently.
          </xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="strict"/>
            <xs:enumeration value="lenient"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
</xs:schema>
<!-- spell: ignore codeautowrap codeprefix codewraplength codewrapoff imgsrc lasttime numwriteups
  spell: ignore timeformat codeauthor codecategory codedescription displaytype xmlstyle createtime
  spell: ignore lastupdate nodetype -->