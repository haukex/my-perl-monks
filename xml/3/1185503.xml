<doctext field_name="doctext">&lt;p&gt;[doc://substr] is also an lvalue sub, but its return value can also be magic...&lt;/p&gt;
&lt;c&gt;
$ perl -lwMstrict
my $x="abcdefghi";
for (substr $x,1,3) {
  print;
  s/c/C/;
  print;
}
print $x;
my $y = \substr $x,5,3;
$$y=~s/g/G/;
print $x;
__END__
bcd
bCd
abCdefghi
abCdefGhi
&lt;/c&gt;
</doctext>
