<author id="830549">haukex</author>
<doctext field_name="doctext">&lt;p&gt;Fun fact: the delimiters can even be word characters, provided there's whitespace after the &lt;c&gt;qq&lt;/c&gt;:&lt;/p&gt;
&lt;c&gt;
$ perl -wMstrict -le 'print qq queueq'
ueue
$ perl -wMstrict -le 'print qq 01230'
123
&lt;/c&gt;
</doctext>
