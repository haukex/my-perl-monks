<author id="1172229">tybalt89</author>
<doctext field_name="doctext">&lt;p&gt;
Out of curiosity, I tried tr/// instead of regex, much faster :)
&lt;/p&gt;
&lt;c&gt;
sub validatetr {
  local $_ = shift;
  length &gt;= 20              ? 1 :
    !tr/a-z// || !tr/A-Z//  ? 0 :
    length &gt;= 16            ? 1 :
    !tr/0-9//               ? 0 :
    length &gt;= 12            ? 1 :
    !tr/a-zA-Z0-9//c        ? 0 :
    length &gt;= 8             ? 1 :
    0;
  }
&lt;/c&gt;</doctext>
