<author id="200365">Tux</author>
<doctext field_name="doctext">&lt;p&gt;If you only want the first lines starting with &lt;c&gt;#&lt;/c&gt; to be filtered, that is indeeed what filter is for:&lt;/p&gt;

&lt;code&gt;
use Data::Peek;
use Text::CSV_XS qw( csv );

my $r = 0;
my $aoa = csv (in =&gt; *DATA, filter =&gt; sub { $_[1][0] =~ m/^\s*#/ ? $r : ++$r; });
DDumper $aoa;
__END__
# This is comment
# and so is this
# and this
a,b,c
#but,not,this
1,2,3
&lt;/code&gt;
&lt;p&gt;--&gt;&lt;/p&gt;
&lt;code&gt;
[
    [   'a',
        'b',
        'c'
        ],
    [   '#but',
        'not',
        'this'
        ],
    [   '1',
        '2',
        '3'
        ]
    ]
&lt;/code&gt;
