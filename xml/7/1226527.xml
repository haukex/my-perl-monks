<doctext field_name="doctext">&lt;p&gt;One pattern you can apply for that kind of thing is:&lt;/p&gt;
&lt;c&gt;
my $answer = 42;
while (1) {
    print "What is the answer? ";
    chomp( my $input = &lt;STDIN&gt; );
    if ( $input == $answer ) {
        print "Good!\n";
        last;  # break out of innermost loop
    }
    else {
        print "Please try again.\n";
    }
}
&lt;/c&gt;
</doctext>
