while($text =~ /&lt;foo&gt;(.*?)&lt;\/foo&gt;/g)
	{
	push (@la,$1);
	};
sort @la;	
foreach(@la)
	{
	print "&lt;foo&gt;$_&lt;\/foo&gt;\n";
	}
