<doctext field_name="doctext">&lt;blockquote&gt;&lt;i&gt;I will be very thankful if you can also explain to me the other metacharacters like + , * , (.) and backreferences&lt;/i&gt;&lt;/blockquote&gt;
&lt;p&gt;[doc://perlretut] is a good start. For your question:&lt;/p&gt;
&lt;table border="1" cellpadding="3" cellspacing="0"&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;coa&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;coma&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;comma&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;commma&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;commmma&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;/com?a/&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="green"&gt;&amp;#x2714;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="green"&gt;&amp;#x2714;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="red"&gt;&amp;#x2718;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="red"&gt;&amp;#x2718;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="red"&gt;&amp;#x2718;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;/com*a/&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="green"&gt;&amp;#x2714;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="green"&gt;&amp;#x2714;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="green"&gt;&amp;#x2714;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="green"&gt;&amp;#x2714;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="green"&gt;&amp;#x2714;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;/com+a/&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="red"&gt;&amp;#x2718;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="green"&gt;&amp;#x2714;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="green"&gt;&amp;#x2714;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="green"&gt;&amp;#x2714;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="green"&gt;&amp;#x2714;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;/co(mm)?a/&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="green"&gt;&amp;#x2714;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="red"&gt;&amp;#x2718;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="green"&gt;&amp;#x2714;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="red"&gt;&amp;#x2718;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="red"&gt;&amp;#x2718;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;/co(m|mmm)a/&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="red"&gt;&amp;#x2718;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="green"&gt;&amp;#x2714;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="red"&gt;&amp;#x2718;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="green"&gt;&amp;#x2714;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="red"&gt;&amp;#x2718;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;/com{2}a/&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="red"&gt;&amp;#x2718;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="red"&gt;&amp;#x2718;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="green"&gt;&amp;#x2714;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="red"&gt;&amp;#x2718;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="red"&gt;&amp;#x2718;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;/com{0,2}a/&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="green"&gt;&amp;#x2714;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="green"&gt;&amp;#x2714;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="green"&gt;&amp;#x2714;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="red"&gt;&amp;#x2718;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="red"&gt;&amp;#x2718;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;/com{2,3}a/&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="red"&gt;&amp;#x2718;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="red"&gt;&amp;#x2718;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="green"&gt;&amp;#x2714;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="green"&gt;&amp;#x2714;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="red"&gt;&amp;#x2718;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;/com{3,}a/&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="red"&gt;&amp;#x2718;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="red"&gt;&amp;#x2718;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="red"&gt;&amp;#x2718;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="green"&gt;&amp;#x2714;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color="green"&gt;&amp;#x2714;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;/table&gt;
&lt;readmore title="code to generate the above table"&gt;
&lt;c&gt;
use warnings;
use strict;
use HTML::Tiny;
 
my @tests = map { 'co'.('m'x$_).'a' } 0..4;
my @regexes = do { no warnings 'qw'; qw/ com?a com*a com+a co(mm)?a
	co(m|mmm)a com{2}a com{0,2}a com{2,3}a com{3,}a / };

my $h = HTML::Tiny-&gt;new;
print $h-&gt;table( {border=&gt;1,cellpadding=&gt;3,cellspacing=&gt;0},
	[ \'tr',
		[ \'td', '', map { $h-&gt;code($_) } @tests ],
		map( { my $r=$_;
			[ \'td', $h-&gt;code("/$r/"),
				map( { /$r/
					? $h-&gt;tag('font', {color=&gt;'green'}, '&amp;#x2714;')
					: $h-&gt;tag('font', {color=&gt;'red'}, '&amp;#x2718;')
					} @tests ),
			]
		} @regexes ),
	] );
&lt;/c&gt;
&lt;/readmore&gt;</doctext>
