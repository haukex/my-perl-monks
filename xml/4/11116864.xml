<author id="5348">Corion</author>
<doctext field_name="doctext">&lt;p&gt;If you're not tied to creating objects, I found locking hashes quite good to prevent typos:&lt;/p&gt;
&lt;c&gt;
use Hash::Util 'lock_keys';
my $hash = h2o { foo =&gt; "bar", x =&gt; "y" }, qw/ more keys /;

lock_keys $hash;

print $hash-&gt;{ foo }, "\n";  # prints "bar"
$hash-&gt;{ x } = "z";  # setter

$hash-&gt;{batman} = 'secret'; # dies
&lt;/c&gt;</doctext>
