<author id="830549">haukex</author>
<doctext field_name="doctext">&lt;p&gt;Have a look at a templating engine like [mod://Template::Toolkit], or perhaps [mod://HTML::Tiny]:&lt;/p&gt;
&lt;c&gt;
use warnings;
use strict;
use HTML::Tiny;

my $hashref = {
	'Adam'  =&gt; 'Eve',
	'Clyde' =&gt; 'Bonnie',
};

my $h = HTML::Tiny-&gt;new;
print $h-&gt;table( [ $h-&gt;tr(
	[ $h-&gt;th( 'Foo', 'Bar' ) ],
	map( {
		[ $h-&gt;td( $_, $hashref-&gt;{$_} ) ]
	} sort keys %$hashref )
) ] );

__END__

&lt;table&gt;&lt;tr&gt;&lt;th&gt;Foo&lt;/th&gt;&lt;th&gt;Bar&lt;/th&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;Adam&lt;/td&gt;&lt;td&gt;Eve&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;Clyde&lt;/td&gt;&lt;td&gt;Bonnie&lt;/td&gt;&lt;/tr&gt;
&lt;/table&gt;
&lt;/c&gt;

