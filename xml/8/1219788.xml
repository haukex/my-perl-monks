<node id="1219788" title="Re: sequential substitutions" created="2018-08-03 06:01:01" updated="2018-08-03 06:01:01" _doctext_mode="strict"><type id="11">note</type>
<author id="830549">haukex</author>
<doctext field_name="doctext">&lt;p&gt;See [id://1201438] for why it's not a good idea to do something like this without modules.&lt;/p&gt;
&lt;c&gt;
use warnings;
use strict;
use Mojo::DOM;

my $xml = &lt;&lt;'ENDXML';
&lt;foo&gt;3&lt;/foo&gt;
&lt;foo&gt;14&lt;/foo&gt;
&lt;foo&gt;159&lt;/foo&gt;
ENDXML

my $dom = Mojo::DOM-&gt;new-&gt;xml(1)-&gt;parse($xml);
my $i = 1;
$dom-&gt;find('foo')-&gt;each(sub{ $_-&gt;content($i++) });
print $dom-&gt;to_string;

__END__

&lt;foo&gt;1&lt;/foo&gt;
&lt;foo&gt;2&lt;/foo&gt;
&lt;foo&gt;3&lt;/foo&gt;
&lt;/c&gt;</doctext>
