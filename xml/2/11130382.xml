<doctext field_name="doctext">&lt;p&gt;Well, there &lt;i&gt;is&lt;/i&gt; of course a way of doing it, but it's not pretty...&lt;/p&gt;

&lt;code&gt;sub brutesay{
	if(@_&gt;=1){
		for(@_){print("$_\n")}
	}else{
		($package,$filename,$line) = caller;
		open $fh,$filename;
		for $i(0..$line-2){&lt;$fh&gt;}
		if(&lt;$fh&gt;=~/brutesay *(\(\))? *;/){print "$_\n";}
	}
}&lt;/code&gt;</doctext>
