<node id="11137192" title="Re: Peculiar hash behavior" created="2021-10-01 23:46:57" updated="2021-10-01 23:46:57" _doctext_mode="lenient"><type id="11">note</type>
<author id="540414">jwkrahn</author>
<doctext field_name="doctext">&lt;p&gt;
Change:
&lt;/p&gt;
&lt;c&gt;
use Data::Dumper;
&lt;/c&gt;
&lt;p&gt;
To:
&lt;/p&gt;
&lt;c&gt;
use Data::Dumper;
$Data::Dumper::Useqq = 1;
&lt;/c&gt;


&lt;c&gt;
$ perl -le'
use Data::Dumper;
$Data::Dumper::Useqq = 1;
my %h1;

$h1{(1, 1)} = 17;
$h1{(2, 2)} = 19;
$h1{("", 22)} = 23;
$h1{(22, "")} = 22;
my @h = (3, 4, 5);
$h1{(@h)} = 44;
print Dumper(\%h1);
'
$VAR1 = {
          "2\0342" =&gt; 19,
          "1\0341" =&gt; 17,
          "\03422" =&gt; 23,
          "22\34" =&gt; 22,
          "3" =&gt; 44
        };


&lt;/c&gt;

&lt;p&gt;
Or change the value of &lt;c&gt;$;&lt;/c&gt;:
&lt;/p&gt;
&lt;c&gt;
$ perl -le'
use Data::Dumper;                          
my %h1;
$; = "--";

$h1{(1, 1)} = 17;
$h1{(2, 2)} = 19;
$h1{("", 22)} = 23;
$h1{(22, "")} = 22;
my @h = (3, 4, 5);
$h1{(@h)} = 44;
print Dumper(\%h1);
'
$VAR1 = {
          '2--2' =&gt; 19,
          '--22' =&gt; 23,
          '3' =&gt; 44,
          '1--1' =&gt; 17,
          '22--' =&gt; 22
        };

&lt;/c&gt;
</doctext>
